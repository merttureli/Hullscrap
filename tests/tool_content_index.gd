extends SceneTree
## Not a test (the runner only loads test_*.gd). Writes docs/CONTENT_INDEX.md, the list of what is in the game
## (core data and every pack), so we can watch it grow:
##   godot --headless --path . --script res://tests/tool_content_index.gd
## Counts per kind, family, line and tier; a table of every component, weapon, material, item, ship, species and
## pack; events per type; the parts that sit outside their balance band under a waiver; and the placeable ids with
## no art yet. No dates, so running it twice gives the same file. Commit the result with the content change.

const Content = preload("res://scripts/data/content.gd")
const Balance = preload("res://scripts/data/balance.gd")
const Stats = preload("res://scripts/sim/stats.gd")

const OUT := "res://docs/CONTENT_INDEX.md"


func _init() -> void:
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	if f == null:
		printerr("cannot write " + OUT)
		quit(1)
		return
	f.store_string(build())
	f.close()
	print("wrote " + OUT)
	quit()


func build() -> String:
	var out: Array[String] = []
	out.append("# Content index")
	out.append("")
	out.append("Generated by `godot --headless --path . --script res://tests/tool_content_index.gd`: do not edit by hand. It lists the core data (`data/*.json`) and every pack (`data/packs/<id>/`); how to add content is in `docs/CONTENT_PLAN.md` section 7.")
	var problems := Content.errors()
	if not problems.is_empty():
		out.append("")
		out.append("## Load problems")
		out.append("")
		for p in problems:
			out.append("- " + _esc(p))
	_totals(out)
	_components(out)
	_weapons(out)
	_simple(out, "Materials", "materials", ["id", "name", "rarity"])
	_simple(out, "Items", "items", ["id", "name", "kind"])
	_ships(out)
	_species(out)
	_events(out)
	_packs(out)
	_balance(out)
	_art(out)
	return "\n".join(out) + "\n"


# --- sections -----------------------------------------------------------------------------------

func _totals(out: Array[String]) -> void:
	out.append("")
	out.append("## Totals")
	out.append("")
	var rows := []
	for kind in Content.KINDS + Content.FOLDER_KINDS:
		var n := Content.ids(kind).size()
		var core := 0
		for id in Content.ids(kind):
			core += 1 if Content.origin(kind, id) == "core" else 0
		rows.append([kind, n, core, n - core])
	rows.append(["name pools", Content.names().size(), "", ""])
	_table(out, ["kind", "entries", "core", "packs"], rows)


func _components(out: Array[String]) -> void:
	var comps := Content.list("components")
	var art := 0
	for c in comps:
		art += 1 if Content.has_art(c["id"]) else 0
	out.append("")
	out.append("## Components (%d, %d with art of their own)" % [comps.size(), art])
	var lines: Array = Stats.load_lines().keys()
	var families := {}
	var tiers := {}
	for c in comps:
		families[str(c.get("family", ""))] = true
		tiers[int(c.get("tier", 1))] = true
		if not lines.has(str(c.get("line", Stats.DEFAULT_LINE))):
			lines.append(str(c.get("line", Stats.DEFAULT_LINE)))
	var fams := families.keys()
	fams.sort()
	var tier_list := tiers.keys()
	tier_list.sort()
	out.append("")
	out.append("By family, line and tier:")
	out.append("")
	var head := ["family", "all"]
	for l in lines:
		head.append(l)
	for t in tier_list:
		head.append("Mk%d" % t)
	head.append("unique")
	var rows := []
	for fam in fams:
		var mine := comps.filter(func(c): return str(c.get("family", "")) == fam)
		var row := [fam, mine.size()]
		for l in lines:
			row.append(mine.filter(func(c): return str(c.get("line", Stats.DEFAULT_LINE)) == l).size())
		for t in tier_list:
			row.append(mine.filter(func(c): return int(c.get("tier", 1)) == t).size())
		row.append(mine.filter(func(c): return c.get("unique", false) == true).size())
		rows.append(row)
	_table(out, head, rows)
	var sorted := comps.duplicate()
	sorted.sort_custom(func(a, b): return _key(a) < _key(b))
	rows = []
	for c in sorted:
		var s: Array = c.get("size", [0, 0])
		rows.append([c["id"], c.get("name", ""), c.get("family", ""), c.get("line", Stats.DEFAULT_LINE), "Mk%d" % int(c.get("tier", 1)),
			"%dx%d" % [int(s[0]), int(s[1])], "%+d" % int(c.get("power", 0)), "yes" if c.get("unique", false) == true else "", "yes" if Content.has_art(c["id"]) else "NO", Content.origin("components", c["id"])])
	out.append("")
	_table(out, ["id", "name", "family", "line", "tier", "size", "power", "unique", "art", "from"], rows)


func _weapons(out: Array[String]) -> void:
	var ws := Content.list("weapons")
	out.append("")
	out.append("## Weapons (%d)" % ws.size())
	out.append("")
	var rows := []
	for w in ws:
		var part := Content.entry("components", w["id"])
		rows.append([w["id"], part.get("name", "(arena test weapon)"), w.get("kind", ""), w.get("damage_type", ""), _n(w.get("damage", "")), _n(w.get("cooldown", "")),
			_n(w.get("range", "")), _n(w.get("arc", "")), _n(w.get("shots", 1)), Content.origin("weapons", w["id"])])
	_table(out, ["id", "part", "kind", "damage type", "damage", "cooldown", "range", "arc", "shots", "from"], rows)


func _simple(out: Array[String], title: String, kind: String, cols: Array) -> void:
	var list := Content.list(kind)
	out.append("")
	out.append("## %s (%d)" % [title, list.size()])
	out.append("")
	var rows := []
	for e in list:
		var row := []
		for c in cols:
			row.append(e.get(c, ""))
		row.append(Content.origin(kind, e["id"]))
		rows.append(row)
	_table(out, cols + ["from"], rows)


func _ships(out: Array[String]) -> void:
	var list := Content.ships()
	out.append("")
	out.append("## Ships (%d)" % list.size())
	out.append("")
	var rows := []
	for s in list:
		var d: Dictionary = s["design"]
		var comps = d.get("components", {})
		rows.append([s["id"], s["name"], (comps.get("instances", []) as Array).size() if comps is Dictionary else 0, (d.get("tiles", []) as Array).size(), s["pack"]])
	_table(out, ["id", "name", "components", "tiles", "from"], rows)


func _species(out: Array[String]) -> void:
	var list := Content.list("species")
	if list.is_empty():
		return
	out.append("")
	out.append("## Species (%d)" % list.size())
	out.append("")
	var rows := []
	for s in list:
		rows.append([s["id"], s.get("name", ""), _n(s.get("hp", "")), _n(s.get("speed", "")), ", ".join(PackedStringArray(s.get("traits", []))), Content.origin("species", s["id"])])
	_table(out, ["id", "name", "hp", "speed", "traits", "from"], rows)


func _events(out: Array[String]) -> void:
	var list := Content.events()
	out.append("")
	out.append("## Events (%d)" % list.size())
	if list.is_empty():
		out.append("")
		out.append("(none)")
		return
	var by_type := {}
	for e in list:
		by_type[str(e.get("type", "?"))] = int(by_type.get(str(e.get("type", "?")), 0)) + 1
	var types := by_type.keys()
	types.sort()
	out.append("")
	_table(out, ["type", "events"], types.map(func(t): return [t, by_type[t]]))


func _packs(out: Array[String]) -> void:
	var packs := Content.packs()
	out.append("")
	out.append("## Packs (%d)" % packs.size())
	out.append("")
	if packs.is_empty():
		out.append("No packs yet: everything above is core data.")
	else:
		var rows := []
		for p in packs:
			var parts: Array[String] = []
			for kind in Content.KINDS + Content.FOLDER_KINDS:
				var n := 0
				for id in Content.ids(kind):
					n += 1 if Content.origin(kind, id) == p["id"] else 0
				if n > 0:
					parts.append("%s %d" % [kind, n])
			rows.append([p["id"], p["name"], p["version"], ", ".join(PackedStringArray(p["requires"])), ", ".join(PackedStringArray(parts)), p["notes"]])
		_table(out, ["id", "name", "version", "requires", "adds", "notes"], rows)
	var overrides := Content.overrides()
	if overrides.is_empty():
		return
	out.append("")
	out.append("Overrides:")
	out.append("")
	_table(out, ["kind", "id", "pack", "replaced", "reason"], overrides.map(func(o): return [o["kind"], o["id"], o["pack"], o["replaced"], o["reason"]]))


func _balance(out: Array[String]) -> void:
	var table := Balance.load_table()
	var lines := Stats.load_lines()
	var counts := {}
	var waived := []
	for c in Content.list("components"):
		var r := Balance.check(table, c, lines)
		counts[r["status"]] = int(counts.get(r["status"], 0)) + 1
		if r["status"] == "waived":
			waived.append([c["id"], " ".join(PackedStringArray(r["problems"])), table["waivers"][c["id"]]])
	out.append("")
	out.append("## Balance bands (`data/balance.json`)")
	out.append("")
	var fams: Array = table.get("bands", {}).keys()
	out.append("Families with bands: %s. Parts: %d within the band, %d with a quirk, %d unique (not held to it), %d relics (excused by a quirk or a cost), %d waived, %d in a family without bands." % [
		", ".join(PackedStringArray(fams)), counts.get("ok", 0), counts.get("quirk", 0), counts.get("unique", 0), counts.get("relic", 0), counts.get("waived", 0), counts.get("none", 0)])
	if not waived.is_empty():
		out.append("")
		out.append("Waived (off the band today, to be fixed by their wave):")
		out.append("")
		_table(out, ["part", "what is off", "why it is waived"], waived)


func _art(out: Array[String]) -> void:
	var missing := []
	for c in Content.list("components"):
		if not Content.has_art(c["id"]):
			missing.append(c)
	out.append("")
	out.append("## Placeable ids with no art of their own (%d of %d)" % [missing.size(), Content.ids("components").size()])
	out.append("")
	if missing.is_empty():
		out.append("None: every component has `art/components/<id>.png`.")
	for c in missing:
		out.append("- `%s` (%s)" % [c["id"], c.get("name", "")])


# --- helpers ------------------------------------------------------------------------------------

func _key(c: Dictionary) -> String:
	return "%s|%s|%02d|%s" % [c.get("family", ""), c.get("line", ""), int(c.get("tier", 1)), c["id"]]


## A number without a pointless ".0"; anything else as text.
func _n(v) -> String:
	if v is float and v == floorf(v):
		return str(int(v))
	return str(v)


func _esc(v) -> String:
	return str(v).replace("|", "\\|").replace("\n", " ")


func _table(out: Array[String], head: Array, rows: Array) -> void:
	if rows.is_empty():
		out.append("(none)")
		return
	out.append("| " + " | ".join(PackedStringArray(head.map(func(h): return _esc(h)))) + " |")
	out.append("|" + "---|".repeat(head.size()))
	for r in rows:
		out.append("| " + " | ".join(PackedStringArray(r.map(func(v): return _esc(v)))) + " |")
